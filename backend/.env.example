APP_ENV=development
PORT=8080
# 複数指定する場合はカンマ区切り（例: http://localhost:5173,https://example.pages.dev）
FRONTEND_ORIGIN=http://localhost:5173
# 手前にある信頼できるプロキシの段数。ゲストの回数制限で、X-Forwarded-Forを右から何番目まで信じるかを決める。
# 0または未設定ならX-Forwarded-Forを見ず、接続元のIPで数える（ローカル開発はこのままでよい）
# APP_ENV=productionでは未設定だと起動しない。プロキシを通さないなら0を明示する
TRUSTED_PROXY_HOPS=0
DATABASE_URL=
CLERK_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
